# Override BENCHMARK_ARGS to select Hungarian matching or acceptance cuts.
# Submit with -append 'RUN_SPECS=--run /path/to/run LABEL ...'.
executable = scripts/condor_run_mass_benchmark.sh

PROJECT_DIR = /eos/home-y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
MANIFEST_DIR = /eos/home-y/yelberke/enhancing-ntp4jets/manifests/production_final
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env
BENCHMARK_ARGS = --candidate-mode leading_pt

arguments = $(PROJECT_DIR) $(OUTPUT_DIR)/higgs_mass_multirun_$(Cluster) higgs $(MANIFEST_DIR)/ggHbb_test.txt $(BENCHMARK_ARGS) $(RUN_SPECS)
environment = "CONDA_ENV=$(CONDA_ENV) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) ORBIT_MANIFEST_DIR=$(MANIFEST_DIR) WANDB_MODE=online"

log    = $(OUTPUT_DIR)/condor_logs/orbit_higgs_mass_multirun_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_higgs_mass_multirun_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_higgs_mass_multirun_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
request_cpus = 4
request_memory = 16GB
request_gpus = 1
+JobFlavour = "tomorrow"
queue 1
