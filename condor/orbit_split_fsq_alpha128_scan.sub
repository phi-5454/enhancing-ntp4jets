# Split-quantizer FSQ scan with alpha branch levels [128].
# Submit from the repository root:
#   mkdir -p /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs
#   condor_submit condor/orbit_split_fsq_alpha128_scan.sub

executable = scripts/condor_run_training.sh

PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
SUITE_ID = orbit_split_fsq_alpha128_scan_$(Cluster)

ORBIT_MANIFEST_DIR = /eos/user/y/yelberke/gghbb_minbias_files
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) train $(SUITE_ID) $(Process) \
  experiment=orbit_jet_puppi_ak8_ggHbb_minbias \
  model=$(MODEL_CONFIG) \
  logger=wandb.yaml \
  task_name=orbit_particle_ggHbb_minbias_$(RUN_NAME) \
  logger.wandb.name=orbit_particle_ggHbb_minbias_$(RUN_NAME)_$(Cluster)_$(Process) \
  logger.wandb.group=$(SUITE_ID) \
  logger.wandb.project=orbit-tokenizer \
  model.model_kwargs.causal_decoder=false \
  callbacks.orbit_plotting_callback.include_codebook_histogram=false \
  test=true \
  trainer.max_epochs=30 \
  trainer.limit_train_batches=null \
  trainer.limit_val_batches=null \
  data.num_workers=4

environment = "ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) CONDA_ENV=$(CONDA_ENV) WANDB_MODE=online"

log    = $(OUTPUT_DIR)/condor_logs/orbit_split_fsq_alpha128_scan_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_split_fsq_alpha128_scan_$(RUN_NAME)_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_split_fsq_alpha128_scan_$(RUN_NAME)_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus = 4
request_memory = 16GB
request_gpus = 1

+JobFlavour = "tomorrow"

queue RUN_NAME, MODEL_CONFIG from (
  fsq_mu_1_alpha_128, model_vqvae_transformer_split_fsq_mu_1_alpha_128
  fsq_mu_2_alpha_128, model_vqvae_transformer_split_fsq_mu_2_alpha_128
  fsq_mu_2_2_alpha_128, model_vqvae_transformer_split_fsq_mu_2_2_alpha_128
  fsq_mu_3_3_alpha_128, model_vqvae_transformer_split_fsq_mu_3_3_alpha_128
  fsq_mu_3_3_2_alpha_128, model_vqvae_transformer_split_fsq_mu_3_3_2_alpha_128
  fsq_mu_5_3_2_alpha_128, model_vqvae_transformer_split_fsq_mu_5_3_2_alpha_128
  fsq_mu_5_4_3_alpha_128, model_vqvae_transformer_split_fsq_mu_5_4_3_alpha_128
  fsq_mu_5_4_3_2_alpha_128, model_vqvae_transformer_split_fsq_mu_5_4_3_2_alpha_128
)
