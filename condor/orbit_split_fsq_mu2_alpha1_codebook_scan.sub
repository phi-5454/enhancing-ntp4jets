# Split-quantizer FSQ scan with mu carrying two scalar channels and alpha one.
# Submit from the repository root:
#   mkdir -p /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs
#   condor_submit condor/orbit_split_fsq_mu2_alpha1_codebook_scan.sub

executable = scripts/condor_run_training.sh

PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
SUITE_ID = orbit_split_fsq_mu2_alpha1_codebook_scan_$(Cluster)

# The ggHbb/minbias split manifests live here:
#   ggHbb_train_val.txt, ggHbb_test.txt, minbias_train_val.txt, minbias_test.txt
ORBIT_MANIFEST_DIR = /eos/user/y/yelberke/gghbb_minbias_files
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) train $(SUITE_ID) $(Process) \
  experiment=orbit_jet_puppi_ak8_ggHbb_minbias \
  model=$(MODEL_CONFIG) \
  logger=wandb.yaml \
  task_name=orbit_particle_ggHbb_minbias_$(RUN_NAME) \
  logger.wandb.name=orbit_particle_ggHbb_minbias_$(RUN_NAME)_$(Cluster)_$(Process) \
  logger.wandb.group=$(SUITE_ID) \
  logger.wandb.project=orbit-tokenizer \
  model.model_kwargs.causal_decoder=false \
  callbacks.orbit_plotting_callback.include_codebook_histogram=false \
  test=true \
  trainer.max_epochs=30 \
  trainer.limit_train_batches=null \
  trainer.limit_val_batches=null \
  data.num_workers=4

environment = "ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) CONDA_ENV=$(CONDA_ENV) WANDB_MODE=online"

log    = $(OUTPUT_DIR)/condor_logs/orbit_split_fsq_mu2_alpha1_scan_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_split_fsq_mu2_alpha1_scan_$(RUN_NAME)_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_split_fsq_mu2_alpha1_scan_$(RUN_NAME)_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus = 4
request_memory = 16GB
request_gpus = 1

+JobFlavour = "tomorrow"

queue RUN_NAME, MODEL_CONFIG from (
  fsq_mu_5x2_alpha_5, model_vqvae_transformer_split_fsq_mu_5x2_alpha_5
  fsq_mu_8x2_alpha_8, model_vqvae_transformer_split_fsq_mu_8x2_alpha_8
  fsq_mu_10x2_alpha_10, model_vqvae_transformer_split_fsq_mu_10x2_alpha_10
  fsq_mu_13x2_alpha_13, model_vqvae_transformer_split_fsq_mu_13x2_alpha_13
  fsq_mu_16x2_alpha_16, model_vqvae_transformer_split_fsq_mu_16x2_alpha_16
  fsq_mu_20x2_alpha_20, model_vqvae_transformer_split_fsq_mu_20x2_alpha_20
  fsq_mu_25x2_alpha_25, model_vqvae_transformer_split_fsq_mu_25x2_alpha_25
)
