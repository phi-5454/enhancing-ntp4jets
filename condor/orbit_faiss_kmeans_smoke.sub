# Small GPU FAISS k-means Condor smoke test.
# Submit with: condor_submit condor/orbit_faiss_kmeans_smoke.sub

executable = scripts/condor_run_training.sh

PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
SUITE_ID = orbit_faiss_kmeans_smoke_$(Cluster)
ORBIT_MANIFEST_DIR = /eos/user/y/yelberke/gghbb_minbias_files
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) train $(SUITE_ID) $(Process) \
  experiment=orbit_jet_puppi_ak8_ggHbb_minbias_faiss_kmeans \
  logger=wandb.yaml \
  task_name=orbit_particle_ggHbb_minbias_faiss_kmeans_smoke \
  logger.wandb.name=orbit_particle_ggHbb_minbias_faiss_kmeans_smoke_$(Cluster)_$(Process) \
  logger.wandb.group=$(SUITE_ID) \
  logger.wandb.project=orbit-tokenizer \
  model.num_codes=128 \
  model.fit_max_particles=10000 \
  model.fit_max_batches=20 \
  model.niter=5 \
  model.upload_codebook_to_wandb=true \
  callbacks.orbit_plotting_callback.include_codebook_histogram=false \
  trainer.limit_test_batches=10 \
  test=true \
  train=false \
  test_without_checkpoint=true \
  data.num_workers=4

environment = "ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) CONDA_ENV=$(CONDA_ENV) WANDB_MODE=online REQUIRE_FAISS_GPU=1"

log    = $(OUTPUT_DIR)/condor_logs/orbit_faiss_kmeans_smoke_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_faiss_kmeans_smoke_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_faiss_kmeans_smoke_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus = 4
request_memory = 8GB
request_gpus = 1

+JobFlavour = "microcentury"

queue 1
