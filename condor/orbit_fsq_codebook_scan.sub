# One HTCondor job per FSQ split-quantizer setting. Submit from the repository root:
#   mkdir -p /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs
#   condor_submit condor/orbit_fsq_codebook_scan.sub
#
# FSQ is currently implemented through model_vqvae_transformer_split. These
# mu-only runs bypass the split Phi/Psi projections, so their three-dimensional
# model latent is quantized directly and their codebook sizes are the product
# of the mu levels.

executable = scripts/condor_run_training.sh

PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
SUITE_ID = orbit_fsq_codebook_scan_$(Cluster)

# The ggHbb/minbias split manifests live here:
#   ggHbb_train_val.txt, ggHbb_test.txt, minbias_train_val.txt, minbias_test.txt
ORBIT_MANIFEST_DIR = /eos/user/y/yelberke/gghbb_minbias_files
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) train $(SUITE_ID) $(Process) \
  experiment=orbit_jet_puppi_ak8_ggHbb_minbias \
  model=$(MODEL_CONFIG) \
  logger=wandb.yaml \
  task_name=orbit_particle_ggHbb_minbias_$(RUN_NAME) \
  logger.wandb.name=orbit_particle_ggHbb_minbias_$(RUN_NAME)_$(Cluster)_$(Process) \
  logger.wandb.group=$(SUITE_ID) \
  logger.wandb.project=orbit-tokenizer \
  model.model_kwargs.causal_decoder=false \
  callbacks.orbit_plotting_callback.include_codebook_histogram=$(INCLUDE_CODE_HIST) \
  test=true \
  trainer.max_epochs=30 \
  trainer.limit_train_batches=null \
  trainer.limit_val_batches=null \
  data.num_workers=4

environment = "ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) CONDA_ENV=$(CONDA_ENV) WANDB_MODE=online"

log    = $(OUTPUT_DIR)/condor_logs/orbit_fsq_scan_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_fsq_scan_$(RUN_NAME)_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_fsq_scan_$(RUN_NAME)_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus = 4
request_memory = 16GB
request_gpus = 1

+JobFlavour = "tomorrow"

queue RUN_NAME, MODEL_CONFIG, INCLUDE_CODE_HIST from (
  fsq_mu_5x3, model_vqvae_transformer_split_fsq_mu_5x3, false
  fsq_mu_8x3, model_vqvae_transformer_split_fsq_mu_8x3, false
  fsq_mu_10x3, model_vqvae_transformer_split_fsq_mu_10x3, false
  fsq_mu_13x3, model_vqvae_transformer_split_fsq_mu_13x3, false
  fsq_mu_16x3, model_vqvae_transformer_split_fsq_mu_16x3, false
  fsq_mu_20x3, model_vqvae_transformer_split_fsq_mu_20x3, false
  fsq_mu_25x3, model_vqvae_transformer_split_fsq_mu_25x3, false
)
