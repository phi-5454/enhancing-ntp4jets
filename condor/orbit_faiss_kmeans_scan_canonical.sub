CANONICAL_EXPERIMENT = orbit_canonical_qcd_tt_vjets_vv
SUITE_BASE = orbit_faiss_kmeans_scan_canonical
RUN_NAME = faiss_kmeans_codes_$(NUM_CODES)
MODEL_ARGS = model=model_faiss_kmeans_baseline model.num_codes=$(NUM_CODES) callbacks.orbit_plotting_callback.include_codebook_histogram=false train=false test_without_checkpoint=true
EXTRA_ENV = REQUIRE_FAISS_GPU=1
include : condor/orbit_canonical_common.sub
queue NUM_CODES in (128, 256, 512, 1024, 2048, 4096, 8192, 16384)
