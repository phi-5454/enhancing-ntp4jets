# One HTCondor job per codebook size. Submit from the repository root:
#   condor_submit condor/orbit_vq_codebook_scan.sub
#
# Edit PROJECT_DIR, OUTPUT_DIR, ORBIT_MANIFEST_DIR, and GABBRO_ENV_FILE for the
# target account/site before submitting. CONDA_ENV should point to an existing
# conda environment on the worker node. Leave GABBRO_ENV_FILE blank only if W&B
# is already configured on the worker node.

executable = scripts/condor_run_training.sh

# Site-specific paths. PROJECT_DIR must be visible on the worker node.
# OUTPUT_DIR should be on a shared filesystem with enough space for Hydra
# outputs, W&B files, checkpoints, and Condor logs.
PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
SUITE_ID = orbit_vq_codebook_scan_$(Cluster)

# The ggHbb/minbias split manifests live here:
#   ggHbb_train_val.txt, ggHbb_test.txt, minbias_train_val.txt, minbias_test.txt
ORBIT_MANIFEST_DIR = /eos/user/y/yelberke/gghbb_minbias_files

# W&B credentials and optional runtime environment. This file is loaded by
# gabbro/train.py before Hydra composes the config.
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env

# Arguments after $(Process) are passed directly to gabbro/train.py as Hydra
# overrides. $(NUM_CODES) is supplied by the queue statement at the bottom, so
# each queued process trains one STE VQ codebook size.
arguments = $(PROJECT_DIR) $(OUTPUT_DIR) train $(SUITE_ID) $(Process) \
  experiment=orbit_jet_puppi_ak8_ggHbb_minbias \
  model=model_vqvae_transformer \
  logger=wandb.yaml \
  task_name=orbit_particle_ggHbb_minbias_vq_ste_codes_$(NUM_CODES) \
  logger.wandb.name=orbit_particle_ggHbb_minbias_vq_ste_codes_$(NUM_CODES)_$(Cluster)_$(Process) \
  logger.wandb.group=$(SUITE_ID) \
  logger.wandb.project=orbit-tokenizer \
  model.model_kwargs.causal_decoder=false \
  model.model_kwargs.vq_kwargs.num_codes=$(NUM_CODES) \
  model.model_kwargs.vq_kwargs.rotation_tr=false \
  callbacks.orbit_plotting_callback.include_codebook_histogram=false \
  test=true \
  trainer.max_epochs=30 \
  trainer.limit_train_batches=null \
  trainer.limit_val_batches=null \
  data.num_workers=4

environment = "ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) CONDA_ENV=$(CONDA_ENV)"

# Condor requires the log directory to exist before submission on many sites:
#   mkdir -p $(OUTPUT_DIR)/condor_logs
log    = $(OUTPUT_DIR)/condor_logs/orbit_vq_ste_scan_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_vq_ste_scan_$(NUM_CODES)_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_vq_ste_scan_$(NUM_CODES)_$(Cluster)_$(Process).err

# The code and outputs live on a shared filesystem, but these settings are kept
# explicit because many HTCondor pools require a file-transfer policy.
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

# Match data.num_workers to request_cpus unless you intentionally oversubscribe.
request_cpus = 4
request_memory = 16GB
request_gpus = 1

# Workday is the starting point for full training. Increase the flavour if the
# cluster evicts jobs before trainer.max_epochs completes.
+JobFlavour = "tomorrow"

# Add or remove values here to change the STE VQ sweep.
queue NUM_CODES in (128, 256, 512, 1024, 2048, 4096, 8192, 16384)
