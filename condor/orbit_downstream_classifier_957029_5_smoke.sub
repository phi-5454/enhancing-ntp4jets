# End-to-end one-epoch downstream classifier smoke test for tokenizer 957029_5.
# It exports 10k balanced train, validation, and paired test events, then trains
# on original events and tests the original/decoded pair. Submit from the repo:
#
#   mkdir -p /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs
#   condor_submit condor/orbit_downstream_classifier_957029_5_smoke.sub

executable = scripts/condor_run_downstream_classifier_smoke.sh

PROJECT_DIR = /eos/home-y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
SUITE_ID = orbit_downstream_classifier_957029_5_smoke_$(Cluster)

TOKENIZER_RUN = /eos/user/y/yelberke/enhancing_ntp4jets_runs/orbit_vq_ste_scan_957029/orbit-particle-ggHbb-minbias/runs/2026-07-20_14-00-19_b9g57n5751_UnriggedDispute
MANIFEST_DIR = /eos/home-y/yelberke/enhancing-ntp4jets/manifests/production_final

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) $(SUITE_ID) $(Process) $(TOKENIZER_RUN) $(MANIFEST_DIR)

environment = "CONDA_ENV=$(CONDA_ENV)"

log    = $(OUTPUT_DIR)/condor_logs/orbit_downstream_classifier_957029_5_smoke_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_downstream_classifier_957029_5_smoke_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_downstream_classifier_957029_5_smoke_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus = 4
request_memory = 16GB
request_gpus = 1

+JobFlavour = "tomorrow"

queue 1
