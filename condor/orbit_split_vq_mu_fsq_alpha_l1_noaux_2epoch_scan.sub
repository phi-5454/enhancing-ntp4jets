# Two-epoch split VQ-mu/FSQ-alpha diagnostic with FSQ alpha auxiliary loss disabled.
# The VQ mu branch keeps its configured loss weight so the VQ codebook still trains.
# Submit from the repository root:
#   mkdir -p /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs
#   condor_submit condor/orbit_split_vq_mu_fsq_alpha_l1_noaux_2epoch_scan.sub

executable = scripts/condor_run_training.sh

PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
SUITE_ID = orbit_split_vq_mu_fsq_alpha_l1_noaux_2epoch_scan_$(Cluster)

# The ggHbb/minbias split manifests live here:
#   ggHbb_train_val.txt, ggHbb_test.txt, minbias_train_val.txt, minbias_test.txt
ORBIT_MANIFEST_DIR = /eos/user/y/yelberke/gghbb_minbias_files
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) train $(SUITE_ID) $(Process) \
  experiment=orbit_jet_puppi_ak8_ggHbb_minbias \
  model=$(MODEL_CONFIG) \
  logger=wandb.yaml \
  task_name=orbit_particle_ggHbb_minbias_l1_noaux_$(RUN_NAME)_$(LR_NAME) \
  logger.wandb.name=orbit_particle_ggHbb_minbias_l1_noaux_$(RUN_NAME)_$(LR_NAME)_$(Cluster)_$(Process) \
  logger.wandb.group=$(SUITE_ID) \
  logger.wandb.project=orbit-tokenizer \
  model.model_kwargs.reconstruction_loss=l1 \
  model.model_kwargs.causal_decoder=false \
  model.model_kwargs.split_quantizer_cfg.branch_loss_weights.mu=0.25 \
  model.model_kwargs.split_quantizer_cfg.branch_loss_weights.alpha=0.0 \
  model.optimizer.lr=$(OPT_LR) \
  model.scheduler.initial_lr=$(SCHED_INITIAL_LR) \
  model.scheduler.max_lr=$(SCHED_MAX_LR) \
  model.scheduler.final_lr=$(SCHED_FINAL_LR) \
  callbacks.orbit_plotting_callback.include_codebook_histogram=false \
  test=true \
  trainer.max_epochs=2 \
  trainer.limit_train_batches=null \
  trainer.limit_val_batches=null \
  data.num_workers=4

environment = "ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) CONDA_ENV=$(CONDA_ENV) WANDB_MODE=online"

log    = $(OUTPUT_DIR)/condor_logs/orbit_split_vq_mu_fsq_alpha_l1_noaux_2epoch_scan_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_split_vq_mu_fsq_alpha_l1_noaux_2epoch_scan_$(RUN_NAME)_$(LR_NAME)_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_split_vq_mu_fsq_alpha_l1_noaux_2epoch_scan_$(RUN_NAME)_$(LR_NAME)_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus = 4
request_memory = 16GB
request_gpus = 1

+JobFlavour = "longlunch"

queue RUN_NAME, MODEL_CONFIG, LR_NAME, OPT_LR, SCHED_INITIAL_LR, SCHED_MAX_LR, SCHED_FINAL_LR from (
  vq_mu_16_fsq_alpha_32, model_vqvae_transformer_split_vq_mu_16_fsq_alpha_32, lr_1e-4, 0.00005, 0.00005, 0.0001, 0.00003
  vq_mu_16_fsq_alpha_32, model_vqvae_transformer_split_vq_mu_16_fsq_alpha_32, lr_1e-5, 0.000005, 0.000005, 0.00001, 0.000003
  vq_mu_16_fsq_alpha_64, model_vqvae_transformer_split_vq_mu_16_fsq_alpha_64, lr_1e-4, 0.00005, 0.00005, 0.0001, 0.00003
  vq_mu_16_fsq_alpha_64, model_vqvae_transformer_split_vq_mu_16_fsq_alpha_64, lr_1e-5, 0.000005, 0.000005, 0.00001, 0.000003
  vq_mu_32_fsq_alpha_32, model_vqvae_transformer_split_vq_mu_32_fsq_alpha_32, lr_1e-4, 0.00005, 0.00005, 0.0001, 0.00003
  vq_mu_32_fsq_alpha_32, model_vqvae_transformer_split_vq_mu_32_fsq_alpha_32, lr_1e-5, 0.000005, 0.000005, 0.00001, 0.000003
  vq_mu_32_fsq_alpha_64, model_vqvae_transformer_split_vq_mu_32_fsq_alpha_64, lr_1e-4, 0.00005, 0.00005, 0.0001, 0.00003
  vq_mu_32_fsq_alpha_64, model_vqvae_transformer_split_vq_mu_32_fsq_alpha_64, lr_1e-5, 0.000005, 0.000005, 0.00001, 0.000003
)
