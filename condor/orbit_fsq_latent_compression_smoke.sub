# Tiny compressed-latent FSQ smoke. Submit from the repository root:
#   mkdir -p /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs
#   condor_submit condor/orbit_fsq_latent_compression_smoke.sub
#
# Runs two 1/2 latent-sequence split-FSQ jobs with alpha=[8192].
# Codebook histograms are explicitly disabled; these codebooks are O(10^8).

executable = scripts/condor_run_training.sh

PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
SUITE_ID = orbit_fsq_latent_compression_smoke_$(Cluster)

ORBIT_MANIFEST_DIR = /eos/user/y/yelberke/gghbb_minbias_files
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) train $(SUITE_ID) $(Process) \
  experiment=orbit_jet_puppi_ak8_ggHbb_minbias_wandb_smoke \
  trainer=gpu.yaml \
  model=$(MODEL_CONFIG) \
  task_name=orbit_particle_ggHbb_minbias_$(RUN_NAME)_latent_ratio_0p5_smoke \
  logger.wandb.name=orbit_particle_ggHbb_minbias_$(RUN_NAME)_latent_ratio_0p5_smoke_$(Cluster)_$(Process) \
  logger.wandb.group=$(SUITE_ID) \
  logger.wandb.project=orbit-tokenizer \
  model.model_kwargs.causal_decoder=false \
  callbacks.orbit_plotting_callback.include_codebook_histogram=false \
  test=true \
  +trainer.log_every_n_steps=1

environment = "ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) CONDA_ENV=$(CONDA_ENV) WANDB_MODE=online"

log    = $(OUTPUT_DIR)/condor_logs/orbit_fsq_latent_compression_smoke_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_fsq_latent_compression_smoke_$(RUN_NAME)_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_fsq_latent_compression_smoke_$(RUN_NAME)_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus = 2
request_memory = 16GB
request_gpus = 1

+JobFlavour = "microcentury"

queue RUN_NAME, MODEL_CONFIG from (
  fsq_mu_5_4_4_3_3_3_2_2_alpha_8192, model_vqvae_transformer_split_fsq_mu_5_4_4_3_3_3_2_2_alpha_8192_latent_compress
  fsq_mu_20x3_alpha_8192, model_vqvae_transformer_split_fsq_mu_20x3_alpha_8192_latent_compress
)
