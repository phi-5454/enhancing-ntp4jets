# Reduced-data, standalone PID-conditioned residual evaluation for the
# canonical mixed-sample VQ-STE 4096 checkpoint.

executable = scripts/condor_run_pid_pulls.sh

PROJECT_DIR = /eos/home-y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
MANIFEST_DIR = /eos/home-y/yelberke/enhancing-ntp4jets/manifests/production_final
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env
RUN_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs/orbit_vq_ste_scan_canonical_orbit_canonical_qcd_tt_vjets_vv_1001382/orbit-canonical-qcd-tt-vjets-vv/runs/2026-08-25_04-09-47_b9pgpun218_HighbrowDemister

arguments = $(PROJECT_DIR) \
  $(OUTPUT_DIR)/pid_pulls_4096_ZZ_leptonic_$(Cluster) \
  $(RUN_DIR) \
  $(MANIFEST_DIR)/ZZ_leptonic_test.txt

environment = "CONDA_ENV=$(CONDA_ENV) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) PID_PULL_EVENTS=2000"

log    = $(OUTPUT_DIR)/condor_logs/orbit_pid_pulls_4096_espresso_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_pid_pulls_4096_espresso_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_pid_pulls_4096_espresso_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
request_cpus = 2
request_memory = 8GB
request_gpus = 1
+JobFlavour = "espresso"

queue 1
