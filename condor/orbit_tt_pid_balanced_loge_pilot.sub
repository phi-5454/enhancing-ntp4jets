executable = scripts/condor_run_training.sh

PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
ORBIT_MANIFEST_DIR = /eos/home-y/yelberke/enhancing-ntp4jets/manifests/production_final
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env
SUITE_ID = orbit_tt_pid_balanced_loge_pilot_$(Cluster)

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) train $(SUITE_ID) $(Process) \
  experiment=orbit_canonical_tt_pid_balanced_loge_pilot \
  logger=wandb.yaml \
  logger.wandb.name=orbit_canonical_tt_vq_ste_4096_pid_balanced_loge_pilot_$(Cluster)_$(Process) \
  logger.wandb.group=orbit_tt_pid_balanced_loge_pilot_$(Cluster) \
  logger.wandb.project=orbit-tokenizer \
  data.num_workers=4

environment = "CONDA_ENV=$(CONDA_ENV) ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) WANDB_MODE=online"

output = $(OUTPUT_DIR)/condor_logs/orbit_tt_pid_balanced_loge_pilot_$(Cluster)_$(Process).out
error = $(OUTPUT_DIR)/condor_logs/orbit_tt_pid_balanced_loge_pilot_$(Cluster)_$(Process).err
log = $(OUTPUT_DIR)/condor_logs/orbit_tt_pid_balanced_loge_pilot_$(Cluster).log

request_cpus = 4
request_memory = 16GB
request_gpus = 1
+JobFlavour = "microcentury"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
notification = Never

queue 1
