# Continuous-latent reconstruction ceiling for the full-length VQ transformer.
# Submit from the repository root:
#   condor_submit condor/orbit_continuous_autoencoder_baseline.sub

executable = scripts/condor_run_training.sh

PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
SUITE_ID = orbit_continuous_autoencoder_baseline_$(Cluster)
ORBIT_MANIFEST_DIR = /eos/user/y/yelberke/gghbb_minbias_files
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) train $(SUITE_ID) $(Process) \
  experiment=orbit_jet_puppi_ak8_ggHbb_minbias \
  model=model_vqvae_transformer_continuous \
  logger=wandb.yaml \
  task_name=orbit_particle_ggHbb_minbias_continuous_autoencoder \
  logger.wandb.name=orbit_particle_ggHbb_minbias_continuous_autoencoder_$(Cluster)_$(Process) \
  logger.wandb.group=$(SUITE_ID) \
  logger.wandb.project=orbit-tokenizer \
  callbacks.orbit_plotting_callback.include_codebook_histogram=false \
  test=true \
  trainer.max_epochs=30 \
  trainer.limit_train_batches=null \
  trainer.limit_val_batches=null \
  data.num_workers=4

environment = "ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) CONDA_ENV=$(CONDA_ENV) WANDB_MODE=online"

log    = $(OUTPUT_DIR)/condor_logs/orbit_continuous_autoencoder_baseline_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_continuous_autoencoder_baseline_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_continuous_autoencoder_baseline_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus = 4
request_memory = 16GB
request_gpus = 1

+JobFlavour = "tomorrow"

queue 1
