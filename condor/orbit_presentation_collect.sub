executable = scripts/condor_build_orbit_presentation_plots.sh

PROJECT_DIR = /eos/home-y/yelberke/enhancing-ntp4jets
OUTPUT_ROOT = /eos/user/y/yelberke/enhancing_ntp4jets_runs/presentation_plots/canonical_tt_golden
CACHE_DIR = $(OUTPUT_ROOT)/higgs_cache
OBSERVABLE_CACHE_DIR = $(OUTPUT_ROOT)/higgs_observable_cache
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env
COMPARISON_ROOT = /eos/user/y/yelberke/enhancing_ntp4jets_runs/comparisons
FULL_TT = $(COMPARISON_ROOT)/canonical_tt_full_training_like_all/manifest.json
FULL_GGHBB = $(COMPARISON_ROOT)/canonical_tt_full_tt_vs_gghbb_ggHbb/manifest.json
NEAR_TT = $(COMPARISON_ROOT)/canonical_tt_near_4096_training_like_all/manifest.json
NEAR_GGHBB = $(COMPARISON_ROOT)/canonical_tt_near_4096_tt_vs_gghbb_ggHbb/manifest.json

arguments = $(PROJECT_DIR) $(OUTPUT_ROOT) $(CACHE_DIR) $(FULL_TT) $(NEAR_TT) $(FULL_TT) $(FULL_GGHBB) $(NEAR_TT) $(NEAR_GGHBB)
environment = "CONDA_ENV=$(CONDA_ENV) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) WANDB_MODE=online HIGGS_OBSERVABLE_CACHE_DIR=$(OBSERVABLE_CACHE_DIR)"

log = /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs/orbit_presentation_collect_$(Cluster).log
output = /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs/orbit_presentation_collect_$(Cluster).out
error = /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs/orbit_presentation_collect_$(Cluster).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
request_cpus = 4
request_memory = 12GB
request_gpus = 0
+JobFlavour = "workday"
queue 1
