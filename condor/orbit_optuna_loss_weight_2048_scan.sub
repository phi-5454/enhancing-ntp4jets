# Optuna loss-weight tuning near 2048 total codes.
# Submit from the repository root:
#   mkdir -p /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs
#   condor_submit condor/orbit_optuna_loss_weight_2048_scan.sub
#
# Each queued job runs one resumable native Optuna study with 12 short L2 trials
# and minimizes val_metrics/loss_reco. SQLite state, trial configs, and reports
# are written under the job suite directory; per-trial metrics/configs go to W&B.

executable = scripts/condor_run_training.sh

PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
SUITE_ID = orbit_optuna_loss_weight_2048_scan_$(Cluster)

ORBIT_MANIFEST_DIR = /eos/user/y/yelberke/gghbb_minbias_files
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) optuna $(SUITE_ID) $(Process) \
  experiment=orbit_jet_puppi_ak8_ggHbb_minbias \
  hparams_search=$(HPARAMS_CONFIG) \
  logger=wandb.yaml \
  logger.wandb.group=optuna_loss_weight_2048_$(RUN_NAME)_$(Cluster) \
  logger.wandb.project=orbit-tokenizer \
  data.num_workers=4

environment = "ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) CONDA_ENV=$(CONDA_ENV) WANDB_MODE=online"

log    = $(OUTPUT_DIR)/condor_logs/orbit_optuna_loss_weight_2048_scan_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_optuna_loss_weight_2048_scan_$(RUN_NAME)_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_optuna_loss_weight_2048_scan_$(RUN_NAME)_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus = 4
request_memory = 16GB
request_gpus = 1

+JobFlavour = "tomorrow"

queue RUN_NAME, HPARAMS_CONFIG from (
  #vq_ste_2048, orbit_optuna_vq_ste_2048
  vq_rotation_2048, orbit_optuna_vq_rotation_2048
  #fsq_mu_13x3, orbit_optuna_fsq_mu_13x3
  #fsq_alpha32_1920, orbit_optuna_fsq_alpha32_1920
  #fsq_alpha64_1920, orbit_optuna_fsq_alpha64_1920
  #fsq_alpha128_2304, orbit_optuna_fsq_alpha128_2304
  #split_vq_mu_fsq_alpha32_2048, orbit_optuna_split_vq_mu_fsq_alpha32_2048
  #split_vq_mu_fsq_alpha64_2048, orbit_optuna_split_vq_mu_fsq_alpha64_2048
  #split_vq_mu_fsq_alpha128_2048, orbit_optuna_split_vq_mu_fsq_alpha128_2048
)
