# Half-length direct-prefix VQ-STE codebook sweep. Submit from the repository root:
#   mkdir -p /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs
#   condor_submit condor/orbit_vq_ste_prefix_half_scan.sub

executable = scripts/condor_run_training.sh

PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
SUITE_ID = orbit_vq_ste_prefix_half_scan_$(Cluster)

ORBIT_MANIFEST_DIR = /eos/user/y/yelberke/gghbb_minbias_files
GABBRO_ENV_FILE = /eos/user/y/yelberke/wandb.env

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) train $(SUITE_ID) $(Process) \
  experiment=orbit_jet_puppi_ak8_ggHbb_minbias \
  model=model_vqvae_transformer_vq_prefix_half \
  logger=wandb.yaml \
  task_name=orbit_particle_ggHbb_minbias_vq_ste_prefix_half_codes_$(NUM_CODES) \
  logger.wandb.name=orbit_particle_ggHbb_minbias_vq_ste_prefix_half_codes_$(NUM_CODES)_$(Cluster)_$(Process) \
  logger.wandb.group=$(SUITE_ID) \
  logger.wandb.project=orbit-tokenizer \
  model.model_kwargs.causal_decoder=false \
  model.model_kwargs.vq_kwargs.num_codes=$(NUM_CODES) \
  model.model_kwargs.vq_kwargs.rotation_tr=false \
  callbacks.orbit_plotting_callback.include_codebook_histogram=false \
  test=true \
  trainer.max_epochs=30 \
  trainer.limit_train_batches=null \
  trainer.limit_val_batches=null \
  data.num_workers=4

environment = "ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) CONDA_ENV=$(CONDA_ENV) WANDB_MODE=online"

log    = $(OUTPUT_DIR)/condor_logs/orbit_vq_ste_prefix_half_scan_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/orbit_vq_ste_prefix_half_scan_$(NUM_CODES)_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/orbit_vq_ste_prefix_half_scan_$(NUM_CODES)_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus = 4
request_memory = 16GB
request_gpus = 1

+JobFlavour = "tomorrow"

queue NUM_CODES in (128, 256, 512, 1024, 2048, 4096, 8192, 16384)
