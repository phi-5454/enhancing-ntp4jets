executable = scripts/condor_run_higgs_presentation_worker.sh

PROJECT_DIR = /eos/home-y/yelberke/enhancing-ntp4jets
OUTPUT_ROOT = /eos/user/y/yelberke/enhancing_ntp4jets_runs/presentation_plots/canonical_tt_golden
CACHE_DIR = $(OUTPUT_ROOT)/higgs_observable_cache
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
MANIFEST_DIR = /eos/home-y/yelberke/enhancing-ntp4jets/manifests/production_final
FULL_MANIFEST = /eos/user/y/yelberke/enhancing_ntp4jets_runs/comparisons/canonical_tt_full_training_like_all/manifest.json

arguments = $(PROJECT_DIR) $(CACHE_DIR) $(FULL_MANIFEST) $(INDEX) $(MANIFEST_DIR)/ggHbb_test.txt
environment = "CONDA_ENV=$(CONDA_ENV)"

log = /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs/orbit_higgs_presentation_observables_$(Cluster).log
output = /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs/orbit_higgs_presentation_observables_$(Cluster)_$(INDEX).out
error = /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs/orbit_higgs_presentation_observables_$(Cluster)_$(INDEX).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
request_cpus = 4
request_memory = 12GB
request_gpus = 1
+JobFlavour = "espresso"
queue INDEX in (5, 12, 20, 29, 32, 43)
